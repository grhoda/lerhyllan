rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Inget inlogg. Ett bibliotek nås bara med sin hemliga nyckel (minst 20 tecken),
    // och ingen kan lista alla bibliotek.
    match /libraries/{lib}/{document=**} {
      allow read, write: if lib.size() >= 20;
    }
  }
}
